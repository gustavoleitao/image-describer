{
  "name": "image-describer",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "describe": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "build:bundle": "esbuild cli.js --bundle --platform=node --target=node18 --format=cjs --outfile=build/cli.cjs",
    "build": "yarn build:bundle && pkg build/cli.cjs --config package.json"
  },
  "pkg": {
    "targets": [
      "node18-macos",
      "node18-linux",
      "node18-win"
    ],
    "assets": [
      "node_modules/@resvg/resvg-wasm/index_bg.wasm"
    ],
    "outputPath": "dist"
  },
  "description": "A CLI tool to generate accessible image descriptions using OpenAI's GPT-4o model.",
  "author": "Gustavo Leitão",
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "cli-progress": "^3.12.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.1",
    "openai": "^5.10.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
